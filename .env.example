# Copia este archivo a .env y cambia los valores (no subas .env al repositorio).
# Usa solo letras, números y guiones en las contraseñas (van dentro de URLs de conexión).

# Bases de datos (una por servicio; todas las conexiones van con TLS)
POSTGRES_PASSWORD=postgres-admin-cambiar
USERS_DB_PASSWORD=users-svc-cambiar
INCIDENTS_DB_PASSWORD=incidents-svc-cambiar
NOTIFICATIONS_DB_PASSWORD=notifications-svc-cambiar

# Keycloak (servidor de identidad): su base de datos y el administrador de su consola
# Consola: https://localhost/auth/admin  →  usuario kcadmin + esta contraseña
KEYCLOAK_DB_PASSWORD=keycloak-svc-cambiar
KEYCLOAK_ADMIN_PASSWORD=kcadmin-cambiar

# Object Storage S3 (evidencias)
MINIO_ROOT_USER=sentinel
MINIO_ROOT_PASSWORD=minio-cambiar-123

GRAFANA_ADMIN_PASSWORD=grafana-cambiar

# Opcional: notificaciones reales por Telegram (deja vacío para desactivar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
